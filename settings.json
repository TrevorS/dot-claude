{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NEW_INIT": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_RETRY_WATCHDOG": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1",
    "CLAUDE_CODE_WORKFLOWS": "1",
    "CLAUDE_NOTIFY_SOUND": "",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_COST_WARNINGS": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "JJ_EDITOR": "/Users/trevor/.claude/hooks/jj-reject-editor.sh",
    "MCP_CONNECTION_NONBLOCKING": "1"
  },
  "attribution": {
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash(brew install:*)",
      "Bash(brew list:*)",
      "Bash(bun test:*)",
      "Bash(command:*)",
      "Bash(curl:*)",
      "Bash(dig:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(glhf:*)",
      "Bash(gsed:*)",
      "Bash(host:*)",
      "Bash(jj:*)",
      "Bash(kill:*)",
      "Bash(linear-cli:*)",
      "Bash(llm:*)",
      "Bash(make:*)",
      "Bash(mkdir:*)",
      "Bash(networksetup:*)",
      "Bash(nslookup:*)",
      "Bash(open:*)",
      "Bash(openssl s_client:*)",
      "Bash(openssl x509:*)",
      "Bash(osascript:*)",
      "Bash(ping6:*)",
      "Bash(ping:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm list:*)",
      "Bash(stow:*)",
      "Bash(sw_vers:*)",
      "Bash(system_profiler SPDisplaysDataType:*)",
      "Bash(system_profiler SPFontsDataType:*)",
      "Bash(tailscale:*)",
      "Bash(timeout:*)",
      "Bash(tmux:*)",
      "Bash(touch:*)",
      "Bash(traceroute:*)",
      "Bash(uv run ~/.claude/skills/monitoring-ci/ci-monitor.py:*)",
      "Bash(whois:*)",
      "Read(/opt/**)",
      "Read(/usr/local/**)",
      "Read(~/.config/**)",
      "Read(~/.local/**)",
      "Read(~/.rbt2/**)",
      "Read(~/Downloads/**)",
      "Read(~/Library/**)",
      "Skill(glhf)",
      "Skill(searching-history)",
      "Skill(skill-creator)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:dev.to)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:ghostty.org)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:llm.datasette.io)",
      "WebFetch(domain:modelcontextprotocol.io)",
      "WebFetch(domain:neovim.io)",
      "WebFetch(domain:news.ycombinator.com)",
      "WebFetch(domain:nvim-mini.org)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:simonwillison.net)",
      "WebFetch(domain:support.claude.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:www.markdownguide.org)",
      "WebFetch(domain:www.notion.com)",
      "WebSearch"
    ],
    "deny": [
      "Read(~/.env)",
      "Read(~/.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gitconfig)",
      "Read(~/.netrc)",
      "Read(~/.gnupg/**)",
      "Read(~/.npmrc)",
      "Read(~/.secrets.zsh)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Bash(cat *~/.ssh/*)",
      "Bash(cat *~/.aws/*)",
      "Bash(cat *~/.npmrc*)",
      "Bash(cat *~/.secrets*)",
      "Bash(cat *~/.netrc*)",
      "Bash(cat *~/.env*)",
      "Bash(cat *id_rsa*)",
      "Bash(cat *id_ed25519*)",
      "Bash(cat *.pem*)",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_send_message_draft",
      "mcp__claude_ai_Slack__slack_schedule_message",
      "mcp__claude_ai_Slack__slack_create_canvas",
      "mcp__claude_ai_Slack__slack_update_canvas"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "fallbackModel": [
    "sonnet[1m]",
    "claude-haiku-4-5-20251001"
  ],
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/claude-notify.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/flagged-words.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/branch_protection.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/jj_interactive_guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-title.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/claude-notify.sh"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/teammate-idle.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/user-prompt-submit/project-context.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/hooks/status.sh",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "teej-skills@teej-skills": false
  },
  "extraKnownMarketplaces": {
    "teej-skills": {
      "source": {
        "source": "directory",
        "path": "./teej-skills"
      }
    }
  },
  "forceLoginMethod": "claudeai",
  "sandbox": {
    "enabled": false,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "crates.io",
        "registry.npmjs.org",
        "api.anthropic.com",
        "platform.claude.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.cargo",
        "~/.cache",
        "~/.local/share/uv",
        "~/.npm",
        "~/.bun"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.env",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "allowAppleEvents": true,
    "excludedCommands": [
      "docker *",
      "brew *"
    ]
  },
  "skillOverrides": {
    "syncing-claude-config": "user-invocable-only",
    "cleaning-commit-history": "user-invocable-only",
    "executing-test-plans": "user-invocable-only"
  },
  "alwaysThinkingEnabled": true,
  "askUserQuestionTimeout": "5m",
  "emojiCompletionEnabled": false,
  "autoDreamEnabled": true,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:catppuccin-mocha",
  "editorMode": "normal",
  "preferredNotifChannel": "ghostty",
  "switchModelsOnFlag": false,
  "fileCheckpointingEnabled": false,
  "teammateMode": "tmux",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
