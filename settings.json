{
  "includeCoAuthoredBy": false,
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-osascript.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/command_blocker.sh"
          }
        ]
      }
    ]
  },
  "disableBugCommand": true,
  "disableCostWarnings": true,
  "disableErrorReporting": true,
  "disableTelemetry": true,
  "model": "sonnet"
}
