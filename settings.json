{
  "$schema": "https:\/\/json.schemastore.org\/claude-code-settings.json",
  "alwaysThinkingEnabled": true,
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "stable-data@stable-plugins": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "DISABLE_BUG_COMMAND": "true",
    "DISABLE_COST_WARNINGS": "true",
    "DISABLE_ERROR_REPORTING": "true",
    "DISABLE_TELEMETRY": "true",
    "ENABLE_LSP_TOOL": "1"
  },
  "forceLoginMethod": "claudeai",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "~\/.claude\/hooks\/claude-notify.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "~\/.claude\/hooks\/journal-reminder.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~\/.claude\/hooks\/branch_protection.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~\/.claude\/hooks\/claude-notify.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "~\/.claude\/hooks\/post-compact.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "~\/.claude\/hooks\/post-tool-failure.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~\/.claude\/hooks\/user-prompt-submit\/project-context.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "WebSearch",
      "mcp__cj__journal_add",
      "mcp__cj__journal_search",
      "mcp__cj__journal_list",
      "mcp__cj__journal_read",
      "mcp__cj__journal_init",
      "mcp__cj__journal_sync",
      "Bash(jj:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(make:*)",
      "Bash(uv:*)",
      "Bash(cargo:*)",
      "Bash(glhf:*)",
      "Bash(linear-cli:*)",
      "Bash(llm:*)",
      "Bash(claude:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(sort:*)",
      "Bash(wc:*)",
      "Bash(xargs:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(du:*)",
      "Bash(echo:*)",
      "Bash(command:*)",
      "Bash(timeout:*)",
      "Bash(curl:*)",
      "Bash(python3:*)",
      "Bash(gsed:*)",
      "Bash(osascript:*)",
      "Bash(tailscale:*)",
      "Read(~\/.local\/**)",
      "Read(~\/.config\/**)",
      "Read(~\/Library\/**)",
      "Read(\/usr\/local\/**)",
      "Read(\/opt\/**)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:support.claude.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:modelcontextprotocol.io)",
      "WebFetch(domain:llm.datasette.io)",
      "WebFetch(domain:www.notion.com)",
      "WebFetch(domain:www.markdownguide.org)",
      "WebFetch(domain:simonwillison.net)",
      "WebFetch(domain:harper.blog)",
      "mcp__cj__journal_last",
      "mcp__cj__journal_setup",
      "mcp__cj__journal_dir"
    ],
    "defaultMode": "default",
    "deny": [
      "Read(.\/.env)",
      "Read(.\/.env.*)",
      "Read(.\/.aws\/credentials)",
      "Read(.\/.aws\/config)",
      "Read(.\/.ssh\/**)",
      "Read(.\/.gitconfig)",
      "Read(.\/.netrc)",
      "Read(.\/id_rsa*)",
      "Read(.\/id_ed25519*)",
      "Read(.\/*.pem)"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "~\/.claude\/hooks\/status.sh",
    "type": "command"
  }
}
