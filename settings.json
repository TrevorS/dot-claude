{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_BUG_COMMAND": "true",
    "DISABLE_COST_WARNINGS": "true",
    "DISABLE_ERROR_REPORTING": "true",
    "DISABLE_TELEMETRY": "true",
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "WebSearch",
      "mcp__journal__journal_add",
      "mcp__journal__journal_search",
      "mcp__journal__journal_list",
      "mcp__journal__journal_read",
      "mcp__journal__journal_init",
      "mcp__journal__journal_sync",
      "mcp__notion__notion-search",
      "mcp__notion__notion-fetch",
      "mcp__notion__notion-get-comments",
      "mcp__notion__notion-get-teams",
      "mcp__notion__notion-get-users",
      "Bash(jj:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(make:*)",
      "Bash(uv:*)",
      "Bash(cargo:*)",
      "Bash(glhf:*)",
      "Bash(linear-cli:*)",
      "Bash(llm:*)",
      "Bash(claude:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(sort:*)",
      "Bash(wc:*)",
      "Bash(xargs:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(du:*)",
      "Bash(echo:*)",
      "Bash(command:*)",
      "Bash(timeout:*)",
      "Bash(curl:*)",
      "Bash(python3:*)",
      "Bash(gsed:*)",
      "Bash(osascript:*)",
      "Bash(tailscale:*)",
      "Read(~/.local/**)",
      "Read(~/.config/**)",
      "Read(~/Library/**)",
      "Read(/usr/local/**)",
      "Read(/opt/**)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:support.claude.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:modelcontextprotocol.io)",
      "WebFetch(domain:llm.datasette.io)",
      "WebFetch(domain:www.notion.com)",
      "WebFetch(domain:www.markdownguide.org)",
      "WebFetch(domain:simonwillison.net)",
      "WebFetch(domain:harper.blog)",
      "mcp__journal__journal_setup",
      "mcp__journal__journal_dir"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.aws/credentials)",
      "Read(./.aws/config)",
      "Read(./.ssh/**)",
      "Read(./.gitconfig)",
      "Read(./.netrc)",
      "Read(./id_rsa*)",
      "Read(./id_ed25519*)",
      "Read(./*.pem)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/user-prompt-submit/project-context.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-osascript.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/branch_protection.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/status.sh"
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "stable-data@stable-plugins": true,
    "claude-md-management@claude-plugins-official": true
  },
  "forceLoginMethod": "claudeai",
  "alwaysThinkingEnabled": true,
  "skipDangerousModePermissionPrompt": true
}
