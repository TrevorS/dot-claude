{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NEW_INIT": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1",
    "CLAUDE_NOTIFY_SOUND": "",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_COST_WARNINGS": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "MCP_CONNECTION_NONBLOCKING": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(brew install:*)",
      "Bash(brew list:*)",
      "Bash(bun test:*)",
      "Bash(cj:*)",
      "Bash(command:*)",
      "Bash(curl:*)",
      "Bash(dig:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(glhf:*)",
      "Bash(gsed:*)",
      "Bash(host:*)",
      "Bash(jj:*)",
      "Bash(kill:*)",
      "Bash(linear-cli:*)",
      "Bash(llm:*)",
      "Bash(make:*)",
      "Bash(mkdir:*)",
      "Bash(networksetup:*)",
      "Bash(nslookup:*)",
      "Bash(nvim:*)",
      "Bash(open:*)",
      "Bash(openssl s_client:*)",
      "Bash(openssl x509:*)",
      "Bash(osascript:*)",
      "Bash(ping6:*)",
      "Bash(ping:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm list:*)",
      "Bash(stow:*)",
      "Bash(sw_vers:*)",
      "Bash(system_profiler SPDisplaysDataType:*)",
      "Bash(system_profiler SPFontsDataType:*)",
      "Bash(tailscale:*)",
      "Bash(timeout:*)",
      "Bash(tmux:*)",
      "Bash(touch:*)",
      "Bash(traceroute:*)",
      "Bash(uv run ~/.claude/skills/monitoring-ci/ci-monitor.py:*)",
      "Bash(whois:*)",
      "Read(/opt/**)",
      "Read(/usr/local/**)",
      "Read(~/.config/**)",
      "Read(~/.local/**)",
      "Read(~/.rbt2/**)",
      "Read(~/Downloads/**)",
      "Read(~/Library/**)",
      "Skill(glhf)",
      "Skill(searching-history)",
      "Skill(skill-creator)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:dev.to)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:ghostty.org)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:llm.datasette.io)",
      "WebFetch(domain:modelcontextprotocol.io)",
      "WebFetch(domain:neovim.io)",
      "WebFetch(domain:news.ycombinator.com)",
      "WebFetch(domain:nvim-mini.org)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:simonwillison.net)",
      "WebFetch(domain:support.claude.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:www.markdownguide.org)",
      "WebFetch(domain:www.notion.com)",
      "WebSearch"
    ],
    "deny": [
      "Read(~/.env)",
      "Read(~/.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gitconfig)",
      "Read(~/.netrc)",
      "Read(~/.gnupg/**)",
      "Read(~/.npmrc)",
      "Read(~/.secrets.zsh)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Bash(cat *~/.ssh/*)",
      "Bash(cat *~/.aws/*)",
      "Bash(cat *~/.npmrc*)",
      "Bash(cat *~/.secrets*)",
      "Bash(cat *~/.netrc*)",
      "Bash(cat *~/.env*)",
      "Bash(cat *id_rsa*)",
      "Bash(cat *id_ed25519*)",
      "Bash(cat *.pem*)",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_send_message_draft",
      "mcp__claude_ai_Slack__slack_schedule_message",
      "mcp__claude_ai_Slack__slack_create_canvas",
      "mcp__claude_ai_Slack__slack_update_canvas"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-notify.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/journal-reminder.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-tool-failure.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/flagged-words.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/branch_protection.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-notify.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-compact.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/user-prompt-submit/project-context.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/status.sh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "teej-skills@teej-skills": false
  },
  "extraKnownMarketplaces": {
    "teej-skills": {
      "source": {
        "source": "directory",
        "path": "~/.claude/teej-skills"
      }
    }
  },
  "forceLoginMethod": "claudeai",
  "alwaysThinkingEnabled": true,
  "autoDreamEnabled": true,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:catppuccin-mocha",
  "preferredNotifChannel": "ghostty",
  "fileCheckpointingEnabled": false,
  "teammateMode": "auto",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
