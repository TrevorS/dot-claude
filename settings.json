{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_COST_WARNINGS": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_NOTIFY_SOUND": "",
    "ENABLE_LSP_TOOL": "1",
    "MCP_CONNECTION_NONBLOCKING": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "WebSearch",
      "mcp__cj__journal_add",
      "mcp__cj__journal_search",
      "mcp__cj__journal_list",
      "mcp__cj__journal_read",
      "mcp__cj__journal_init",
      "mcp__cj__journal_sync",
      "Bash(jj:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(make:*)",
      "Bash(uv:*)",
      "Bash(cargo:*)",
      "Bash(glhf:*)",
      "Bash(linear-cli:*)",
      "Bash(llm:*)",
      "Bash(claude:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(sort:*)",
      "Bash(wc:*)",
      "Bash(xargs:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(du:*)",
      "Bash(echo:*)",
      "Bash(command:*)",
      "Bash(timeout:*)",
      "Bash(curl:*)",
      "Bash(python3:*)",
      "Bash(gsed:*)",
      "Bash(osascript:*)",
      "Bash(tailscale:*)",
      "Bash(touch:*)",
      "Bash(open:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(lsof:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(sed:*)",
      "Bash(source:*)",
      "Read(~/.rbt2/**)",
      "Read(~/Downloads/**)",
      "Read(~/.local/**)",
      "Read(~/.config/**)",
      "Read(~/Library/**)",
      "Read(/usr/local/**)",
      "Read(/opt/**)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:support.claude.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:modelcontextprotocol.io)",
      "WebFetch(domain:llm.datasette.io)",
      "WebFetch(domain:www.notion.com)",
      "WebFetch(domain:www.markdownguide.org)",
      "WebFetch(domain:simonwillison.net)",
      "WebFetch(domain:harper.blog)",
      "mcp__cj__journal_last",
      "mcp__cj__journal_setup",
      "mcp__cj__journal_dir",
      "mcp__claude_ai_Notion__notion-search",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-create-comment",
      "mcp__claude_ai_Notion__notion-create-pages",
      "mcp__claude_ai_Notion__notion-get-comments",
      "mcp__claude_ai_Notion__notion-get-users",
      "mcp__claude_ai_Notion__notion-update-page",
      "mcp__claude_ai_Slack__slack_read_channel",
      "mcp__claude_ai_Slack__slack_read_thread",
      "mcp__claude_ai_Slack__slack_search_public_and_private",
      "mcp__claude_ai_Slack__slack_search_users",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_read_user_profile",
      "mcp__claude_ai_Slack__slack_search_channels",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_close",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_hover",
      "mcp__playwright__browser_fill_form",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_select_option",
      "mcp__Redshift_Data_Warehouse__redshift_execute_query",
      "mcp__Redshift_Data_Warehouse__redshift_get_schema",
      "mcp__Redshift_Data_Warehouse__redshift_get_schema_names",
      "mcp__Redshift_Data_Warehouse__redshift_get_table_columns",
      "Write(~/.rbt2/**)",
      "Bash(RUN_DIR=*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.aws/credentials)",
      "Read(./.aws/config)",
      "Read(./.ssh/**)",
      "Read(./.gitconfig)",
      "Read(./.netrc)",
      "Read(./id_rsa*)",
      "Read(./id_ed25519*)",
      "Read(./*.pem)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-notify.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/journal-reminder.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "if": "Bash(git commit*) || Bash(git add*) || Bash(jj describe*) || Bash(jj new*) || Bash(jj commit*) || Bash(jj squash*)",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/branch_protection.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "if": "Bash(git commit*) || Bash(jj describe*) || Bash(jj commit*) || Bash(jj squash*) || Bash(jj new*) || Bash(gh pr create*)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/banned-words.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/banned-words.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-notify.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-compact.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-tool-failure.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/user-prompt-submit/project-context.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/status.sh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "telegram-enhanced@trevor-plugins": true,
    "house@trevor-plugins": true,
    "dev@trevor-plugins": true,
    "lua-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "trevor-plugins": {
      "source": {
        "source": "github",
        "repo": "TrevorS/claude-code-plugins"
      }
    }
  },
  "forceLoginMethod": "claudeai",
  "alwaysThinkingEnabled": true,
  "showThinkingSummaries": true,
  "voiceEnabled": true,
  "skipDangerousModePermissionPrompt": true
}
