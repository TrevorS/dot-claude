{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_FORCE_STRIKETHROUGH": "1",
    "CLAUDE_CODE_NEW_INIT": "1",
    "CLAUDE_CODE_RETRY_WATCHDOG": "1",
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1",
    "DISABLE_COST_WARNINGS": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "JJ_EDITOR": "sh -c 'exec \"$HOME/.claude/hooks/jj-reject-editor.sh\"'"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(brew list:*)",
      "Bash(bun test:*)",
      "Bash(command -V:*)",
      "Bash(command -v:*)",
      "Bash(defaults read *)",
      "Bash(dig:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(glhf:*)",
      "Bash(host:*)",
      "Bash(jj:*)",
      "Bash(kill:*)",
      "Bash(linear-cli:*)",
      "Bash(make check *)",
      "Bash(make help *)",
      "Bash(make hook-tests *)",
      "Bash(make lint *)",
      "Bash(make test *)",
      "Bash(make typecheck *)",
      "Bash(make validate *)",
      "Bash(mkdir:*)",
      "Bash(nslookup:*)",
      "Bash(openssl x509:*)",
      "Bash(ping6:*)",
      "Bash(ping:*)",
      "Bash(pnpm list:*)",
      "Bash(sw_vers:*)",
      "Bash(sysctl -n *)",
      "Bash(system_profiler SPDisplaysDataType:*)",
      "Bash(system_profiler SPFontsDataType:*)",
      "Bash(tailscale status *)",
      "Bash(touch:*)",
      "Bash(traceroute:*)",
      "Bash(uv run ~/.claude/skills/monitoring-ci/ci-monitor.py:*)",
      "Bash(whois:*)",
      "Read(//opt/**)",
      "Read(//usr/local/**)",
      "Read(~/.config/**)",
      "Read(~/.local/**)",
      "Read(~/Downloads/**)",
      "Read(~/Library/**)",
      "Skill(searching-history)",
      "Skill(skill-creator:skill-creator)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:dev.to)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:ghostty.org)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:llm.datasette.io)",
      "WebFetch(domain:modelcontextprotocol.io)",
      "WebFetch(domain:neovim.io)",
      "WebFetch(domain:news.ycombinator.com)",
      "WebFetch(domain:nvim-mini.org)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:simonwillison.net)",
      "WebFetch(domain:support.claude.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:www.markdownguide.org)",
      "WebFetch(domain:www.notion.com)",
      "WebSearch"
    ],
    "deny": [
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gitconfig)",
      "Read(~/.config/stripe/**)",
      "Read(~/.config/configstore/firebase-tools.json)",
      "Read(~/.local/share/opencode/auth.json)",
      "Read(~/.local/share/atuin/key)",
      "Read(~/.local/share/crush/**)",
      "Bash(gh auth token *)",
      "Bash(gh auth status *-t*)",
      "Bash(gh gist create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo edit *--visibility*)",
      "Bash(gh release delete *)",
      "Bash(gh api *DELETE*)",
      "Read(~/.netrc)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/github-copilot/**)",
      "Read(~/.config/linear-cli/**)",
      "Read(~/.config/op/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.secrets.zsh)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.pem)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Bash(cat *~/.ssh/*)",
      "Bash(cat *$HOME/.ssh/*)",
      "Bash(cat *~/.aws/*)",
      "Bash(cat *$HOME/.aws/*)",
      "Bash(cat *~/.npmrc*)",
      "Bash(cat *$HOME/.npmrc*)",
      "Bash(cat *~/.secrets*)",
      "Bash(cat *$HOME/.secrets*)",
      "Bash(cat *~/.netrc*)",
      "Bash(cat *$HOME/.netrc*)",
      "Bash(cat *~/.env*)",
      "Bash(cat *$HOME/.env*)",
      "Bash(cat *id_rsa*)",
      "Bash(cat *id_ed25519*)",
      "Bash(cat *.pem*)",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_send_message_draft",
      "mcp__claude_ai_Slack__slack_schedule_message",
      "mcp__claude_ai_Slack__slack_create_canvas",
      "mcp__claude_ai_Slack__slack_update_canvas"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "fallbackModel": [
    "sonnet",
    "claude-opus-4-8"
  ],
  "skillOverrides": {
    "syncing-claude-config": "user-invocable-only",
    "cleaning-commit-history": "user-invocable-only",
    "executing-test-plans": "user-invocable-only",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "name-only",
    "anthropic-skills:docx": "name-only",
    "anthropic-skills:pptx": "name-only",
    "anthropic-skills:ai-office-hours-prep": "off",
    "anthropic-skills:cx-playbook": "off",
    "anthropic-skills:daily-sales-call-prep": "off",
    "anthropic-skills:new-day": "off",
    "anthropic-skills:prep-for-data-extraction-call": "off",
    "anthropic-skills:release-digest": "off",
    "anthropic-skills:stable-data-routing": "off",
    "anthropic-skills:team-plan-metrics": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/branch_protection.sh",
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/branch_protection.sh",
            "if": "Bash(jj *)"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/jj_interactive_guard.sh",
            "if": "Bash(jj *)"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git_dangerous_flags.sh",
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git_dangerous_flags.sh",
            "if": "Bash(gh *)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-title.sh"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/stop-failure-notify.sh"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/teammate-idle.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/user-prompt-submit/project-context.sh"
          }
        ]
      }
    ]
  },
  "bashOutputMaxChars": 100000,
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/hooks/status.sh",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": false,
    "teej-skills@teej-skills": false,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "teej-skills": {
      "source": {
        "source": "directory",
        "path": "./teej-skills"
      }
    }
  },
  "forceLoginMethod": "claudeai",
  "outputStyle": "Concise",
  "sandbox": {
    "enabled": false,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "crates.io",
        "registry.npmjs.org",
        "api.anthropic.com",
        "platform.claude.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.cargo",
        "~/.cache",
        "~/.local/share/uv",
        "~/.npm",
        "~/.bun"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.env",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "docker *",
      "brew *"
    ]
  },
  "maxProseWidth": 100,
  "spellcheck": {
    "enabled": true,
    "color": "#eba0ac"
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "fastModePerSessionOptIn": true,
  "emojiCompletionEnabled": false,
  "askUserQuestionTimeout": "5m",
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true
  },
  "autoDreamEnabled": true,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:catppuccin-mocha",
  "preferredNotifChannel": "ghostty",
  "fileCheckpointingEnabled": false,
  "teammateMode": "tmux",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
