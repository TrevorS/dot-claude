# Theme
theme = Catppuccin Mocha
# Scrollback search (cmd+f) highlights; the theme doesn't set these, so match
# Catppuccin yellow/peach instead of Ghostty's default amber.
search-background = #f9e2af
search-foreground = #1e1e2e
search-selected-background = #fab387
search-selected-foreground = #1e1e2e

# Font — use base font; Ghostty has built-in Nerd Font support
font-family = Berkeley Mono
font-family-bold = Berkeley Mono Bold
font-family-italic = Berkeley Mono Italic
font-family-bold-italic = Berkeley Mono Bold Italic
font-thicken = true

# Typography
adjust-cell-height = 3

# macOS chrome
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
macos-option-as-alt = true

# Display
# window-colorspace stays at the sRGB default: Catppuccin's hex values are sRGB,
# and display-p3 rendered them oversaturated.
window-padding-balance = true
# Blend text in linear space with a weight correction, which drops the dark
# fringes around colored text (red/green on dark bg) that `native` produces.
alpha-blending = linear-corrected
# Never draw text in (nearly) the background color, e.g. an app setting fg == bg.
minimum-contrast = 1.1

# Behavior
mouse-hide-while-typing = true
# Default word boundaries minus `:`, so double-click grabs `src/foo.py:123` and
# URLs whole (same intent as tmux's word-separators).
selection-word-chars = "\t '\"│`|;,()[]{}<>$"
# Restore windows, tabs, splits, and cwds on relaunch. macOS "close windows when
# quitting" is on, so `default` dropped everything on each tip update restart.
window-save-state = always
# 100k lines of history. The old `scrollback-limit` (now `scrollback-limit-bytes`)
# counted bytes, so `100000` capped scrollback at ~100 KB. Bytes go unlimited so
# the line cap governs; idle pages are compressed (scrollback-compression).
scrollback-limit-lines = 100000
scrollback-limit-bytes = unlimited
# macOS notification when a command that ran 30s+ finishes in an unfocused
# surface. Needs OSC 133 marks from shell integration; a Claude Code session
# counts as one long command, so this won't fire per turn.
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s
# Moving between splits while one is zoomed zooms the new one instead of
# unzooming the tree.
split-preserve-zoom = navigation

# Updates — track the tip (nightly) channel; installed via the ghostty@tip cask.
# Tip builds fix rendering issues on the latest macOS before they reach stable.
auto-update-channel = tip
# Download tip builds in the background; they install on the next quit.
auto-update = download

# Shell integration — keep Ghostty defaults but add SSH support so remote hosts
# get the ghostty terminfo auto-installed (ssh-terminfo) and a sane TERM
# fallback (ssh-env). Fixes "unknown terminal type xterm-ghostty" / garbled
# rendering when SSHing into boxes that don't have ghostty's terminfo.
shell-integration-features = cursor,no-sudo,title,path,ssh-env,ssh-terminfo

# Keybinds
keybind = shift+enter=text:\n
# Reset the terminal to a clean state — clears stuck mouse-reporting / alt-screen
# state left behind when a TUI dies uncleanly (SSH drop, crash). Heavier sibling
# of the default super+k (clear_screen).
keybind = super+shift+r=reset
# System-wide drop-down terminal (needs macOS Accessibility permission).
# ctrl+` instead of super+` to avoid the macOS cmd+` window-cycle.
keybind = global:ctrl+backquote=toggle_quick_terminal

# Machine-local overrides (fonts, window size, etc.)
config-file = ?~/.local/ghostty-overrides
