#!/usr/bin/env python3
"""Display an image using the Kitty graphics protocol.

In tmux: opens a split pane (default) or popup (--popup).
Outside tmux: renders inline.

Usage: kitty-img [--popup] [--scale N] <image-file> [max-width-cols]
"""

import argparse
import base64
import os
import subprocess
import sys

CHUNK_SIZE = 4096


def image_dimensions(filepath: str) -> tuple[int, int]:
    try:
        result = subprocess.run(
            ["magick", "identify", "-format", "%w %h", filepath],
            capture_output=True,
            text=True,
        )
        if result.returncode == 0:
            w, h = result.stdout.strip().split()
            return int(w), int(h)
    except (FileNotFoundError, ValueError):
        pass
    return 800, 600


def tmux_dimensions() -> tuple[int, int, int, int]:
    """Returns (cols, rows, cell_width_px, cell_height_px)."""
    result = subprocess.run(
        [
            "tmux",
            "display-message",
            "-p",
            "#{window_width} #{window_height} #{client_cell_width} #{client_cell_height}",
        ],
        capture_output=True,
        text=True,
    )
    parts = result.stdout.strip().split()
    return int(parts[0]), int(parts[1]), int(parts[2]), int(parts[3])


def get_client_tty() -> str | None:
    if not os.environ.get("TMUX"):
        return None
    try:
        result = subprocess.run(
            ["tmux", "display-message", "-p", "#{client_tty}"],
            capture_output=True,
            text=True,
        )
        return result.stdout.strip() or None
    except FileNotFoundError:
        return None


def convert_to_png(filepath: str, max_px: int = 3200) -> bytes:
    try:
        result = subprocess.run(
            ["magick", filepath, "-resize", f"{max_px}x{max_px}>", "PNG:-"],
            capture_output=True,
        )
        if result.returncode == 0:
            return result.stdout
    except FileNotFoundError:
        pass
    with open(filepath, "rb") as f:
        return f.read()


def write_to(tty_path: str | None, data: bytes):
    if tty_path:
        with open(tty_path, "wb") as f:
            f.write(data)
    else:
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()


def send_image_direct(png_data: bytes, max_cols: int, tty_path: str):
    """Render via direct pty write."""
    b64 = base64.b64encode(png_data).decode("ascii")
    total = len(b64)
    offset = 0

    place = f"c={max_cols}"

    while offset < total:
        chunk = b64[offset : offset + CHUNK_SIZE]
        is_first = offset == 0
        is_last = offset + CHUNK_SIZE >= total
        m = 0 if is_last else 1

        if is_first:
            payload = f"\x1b_Gf=100,a=T,t=d,q=2,{place},m={m};{chunk}\x1b\\"
        else:
            payload = f"\x1b_Gm={m},q=2;{chunk}\x1b\\"

        write_to(tty_path, payload.encode())
        offset += CHUNK_SIZE


def send_image_stdout(png_data: bytes, max_cols: int):
    """Render via stdout (bare terminal, no tmux)."""
    b64 = base64.b64encode(png_data).decode("ascii")
    total = len(b64)
    offset = 0
    out = sys.stdout.buffer

    place = f"c={max_cols}"

    while offset < total:
        chunk = b64[offset : offset + CHUNK_SIZE]
        is_first = offset == 0
        is_last = offset + CHUNK_SIZE >= total
        m = 0 if is_last else 1

        if is_first:
            payload = f"\x1b_Gf=100,a=T,t=d,q=2,{place},m={m};{chunk}\x1b\\"
        else:
            payload = f"\x1b_Gm={m},q=2;{chunk}\x1b\\"

        out.write(payload.encode())
        out.flush()
        offset += CHUNK_SIZE


def wait_for_dismiss():
    if sys.stdin.isatty():
        import termios
        import tty

        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            sys.stdin.read(1)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
    else:
        import time

        time.sleep(30)


def cols_to_rows(cols: int, img_w: int, img_h: int, cell_w: int, cell_h: int) -> int:
    """Convert display columns to display rows preserving image aspect ratio."""
    img_px_w = cols * cell_w
    img_px_h = int(img_px_w * img_h / max(img_w, 1))
    return max(-(-img_px_h // cell_h), 1)  # ceil division


def launch_split(filepath: str, max_cols: int, scale: int):
    from shlex import quote

    img_w, img_h = image_dimensions(filepath)
    win_w, win_h, cell_w, cell_h = tmux_dimensions()

    display_cols = max_cols if max_cols > 0 else int(win_w * scale / 100)
    img_rows = cols_to_rows(display_cols, img_w, img_h, cell_w, cell_h)
    pane_height = max(min(img_rows + 2, win_h - 5), 6)

    subprocess.Popen(
        [
            "tmux",
            "split-window",
            "-v",
            "-l",
            str(pane_height),
            f"KITTY_IMG_PANE=1 kitty-img {quote(filepath)} {display_cols}",
        ],
        start_new_session=True,
    )


def launch_popup(filepath: str, max_cols: int, scale: int):
    from shlex import quote

    img_w, img_h = image_dimensions(filepath)
    win_w, win_h, cell_w, cell_h = tmux_dimensions()

    max_popup_w = win_w - 4
    max_popup_h = win_h - 4

    display_cols = max_cols if max_cols > 0 else min(int(win_w * scale / 100), max_popup_w)
    display_rows = cols_to_rows(display_cols, img_w, img_h, cell_w, cell_h)

    # Constrain to fit popup height
    if display_rows > max_popup_h:
        display_rows = max_popup_h
        img_px_h = display_rows * cell_h
        img_px_w = int(img_px_h * img_w / max(img_h, 1))
        display_cols = int(img_px_w / cell_w)

    popup_w = display_cols + 2
    popup_h = display_rows

    subprocess.Popen(
        [
            "tmux",
            "display-popup",
            "-w",
            str(popup_w),
            "-h",
            str(popup_h),
            "-E",
            f"KITTY_IMG_PANE=1 kitty-img --popup {quote(filepath)} {display_cols}",
        ],
        start_new_session=True,
    )


def main():
    parser = argparse.ArgumentParser(description="Display images via Kitty graphics protocol")
    parser.add_argument("--popup", action="store_true", help="Use tmux popup instead of split pane")
    parser.add_argument("--scale", type=int, default=50, help="Display size as percent of window (default: 50)")
    parser.add_argument("file", help="Image file to display")
    parser.add_argument("cols", nargs="?", type=int, default=0, help="Display width in columns (overrides --scale)")
    args = parser.parse_args()

    filepath = os.path.abspath(args.file)
    max_cols = args.cols
    scale = max(10, min(100, args.scale))
    use_popup = args.popup

    if not os.path.isfile(filepath):
        print(f"File not found: {filepath}", file=sys.stderr)
        sys.exit(1)

    in_tmux = bool(os.environ.get("TMUX"))

    # If in tmux and not already inside the viewer pane, relaunch
    if in_tmux and not os.environ.get("KITTY_IMG_PANE"):
        if use_popup:
            launch_popup(filepath, max_cols, scale)
        else:
            launch_split(filepath, max_cols, scale)
        return

    # --- Rendering (inside split/popup or bare terminal) ---

    if max_cols <= 0:
        try:
            max_cols = os.get_terminal_size().columns - 2
        except OSError:
            max_cols = 80

    png_data = convert_to_png(filepath)
    name = os.path.basename(filepath)

    tty_path = get_client_tty() if in_tmux else None

    if tty_path:
        # Direct pty write — works for both split pane and popup in tmux
        import atexit

        if not use_popup:
            sys.stdout.buffer.write(f"{name} — press q to close\n".encode())
            sys.stdout.buffer.flush()

        send_image_direct(png_data, max_cols, tty_path)

        def cleanup():
            write_to(tty_path, b"\x1b_Ga=d,q=2;\x1b\\")

        atexit.register(cleanup)
    else:
        # Bare terminal (no tmux): render inline
        sys.stdout.buffer.write(f"{name} — press q to close\n".encode())
        sys.stdout.buffer.flush()
        send_image_stdout(png_data, max_cols)

    wait_for_dismiss()


if __name__ == "__main__":
    main()
