# Emacs runtime state — elpaca packages and savefiles land next to init.el,
# and `stow --adopt` without --no-folding can fold ~/.config/emacs into the repo
dotfiles/emacs/.config/emacs/*
!dotfiles/emacs/.config/emacs/init.el
!dotfiles/emacs/.config/emacs/early-init.el

# ML models
models/

# Channel runtime state
channels/dev/
channels/house/
channels/telegram/inbox/
channels/telegram/.last-context-restore

# Channel secrets
channels/telegram/.env
channels/telegram/access.json

# Data files
*.db
*.db-shm
*.db-wal
*.jsonl
.credentials.json

# Channel + daemon runtime. `channels/` covers the specific entries above; those
# are kept because they name secrets and should stay obvious if this ever narrows.
channels/
daemon.*
daemon-*

# Config-dir entries from the 2.1.281 binary's own list of what it writes under
# ~/.claude, not covered above. Anchored to the repo root so `local`, `logs`,
# `remote`, etc. can't match nested repo paths; no trailing slash, so each
# matches whether the binary creates a file or a directory. Lock files are
# named individually because `*.lock` would also ignore uv.lock.
/.claude.json
/.claude.json.backup
/.session_ingress_token
/active-time.json
/agent-memory
/agent-memory-local
/agent-memory-project
/antproto.json
/api-dumps
/bridge-spawn
/ccr
/computer-use.lock
/cowork_plugins
/dump-prompts
/feedback
/feedback-bundles
/file-transfers
/hfi-auth.json
/local
/local-settings
/logs
